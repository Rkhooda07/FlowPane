{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowPane",
  "version": "0.1.0",
  "identifier": "com.flowpane.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlowPane",
        "width": 335,
        "height": 405,
        "resizable": true,
        "minWidth": 335,
        "minHeight": 405,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "FlowPane Team",
    "copyright": "Copyright © 2026 FlowPane Team",
    "homepage": "https://github.com/rkhooda/FlowPane",
    "category": "Productivity",
    "shortDescription": "A translucent, always-on-top desktop utility.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}