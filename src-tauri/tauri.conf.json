{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowPane",
  "version": "0.1.0",
  "identifier": "com.flowpane.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlowPane",
        "width": 325,
        "height": 395,
        "resizable": true,
        "minWidth": 325,
        "minHeight": 395,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "publisher": "FlowPane Team",
    "copyright": "Copyright © 2024 FlowPane Team",
    "homepage": "https://github.com/rkhooda/FlowPane",
    "shortDescription": "A translucent, always-on-top desktop utility.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}